# --- generated output (per-user, per-run - never commit) ---
*.pdf
*.csv
*.docx
config.yml
*.json

# (config_example.yml IS tracked - it shows the schema, with no real data)

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- virtual environments ---
.env
.venv
env/
venv/
ENV/

# --- editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
# --- app & server: the rules above are for generated CLI output; these
# folders legitimately track package.json, tsconfig.json, app.json etc. ---
!app/**/*.json
!server/**/*.json
server/data/
app/node_modules/
app/.expo/
app/dist/
app/ios/
app/android/
